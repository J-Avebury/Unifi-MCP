# Server-specific values win over shared UNIFI_* fallbacks.
UNIFI_NETWORK_BASE_URL=https://your-unifi-console.example
UNIFI_NETWORK_SITE=default
UNIFI_NETWORK_API_KEY=replace-with-a-unifi-api-key
# Alternatively, omit the API key and configure a dedicated local account:
# UNIFI_NETWORK_USERNAME=unifi-mcp
# UNIFI_NETWORK_PASSWORD=replace-with-a-local-account-password
UNIFI_NETWORK_VERIFY_SSL=false
UNIFI_NETWORK_REDACT_SENSITIVE_FIELDS=true
RUST_LOG=info
